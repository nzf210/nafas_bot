# App Config
APP_ENV=development
APP_PORT=8080
LOG_LEVEL=debug

# Database (PostgreSQL - External)
DB_HOST=your_external_db_host
DB_PORT=5432
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=nafas_db

# Redis (Local Docker)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Telegram Bot
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_WEBHOOK_URL=https://your-public-domain.com/telegram/webhook

# Security
# AES-256 Key for encrypting API Keys (Must be 32 bytes/characters)
ENCRYPTION_KEY=unhgtbdeg47jnf7hdnt7nerk46he3kw3

# AI/LLM Provider
LLM_PROVIDER_URL=https://api.openai.com/v1
LLM_API_KEY=your_llm_api_key_here
LLM_MODEL=gpt-4-turbo # atau model lain sesuai provider
