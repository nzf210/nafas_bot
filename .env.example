# App Config
APP_ENV=development
APP_PORT=8080
LOG_LEVEL=debug

# Database (PostgreSQL - External)
DB_HOST=your_external_db_host
DB_PORT=5432
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=nafas_db

# Redis (Local Docker)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Telegram Bot
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_WEBHOOK_URL=https://your-public-domain.com/telegram/webhook

# Security
# AES-256 Key for encrypting API Keys (Must be 32 bytes/characters)
ENCRYPTION_KEY=unhgtbdeg47jnf7hdnt7nerk46he3kw3

# AI/LLM Provider (Meridian-style direct call)
# Supports OpenAI, OpenRouter, Ollama, LM Studio via OpenAI-compatible API
LLM_PROVIDER_URL=https://openrouter.ai/api/v1
LLM_API_KEY=your_llm_api_key_here
LLM_MODEL=openrouter/anthropic/claude-3.5-sonnet
LLM_BASE_URL= # Optional: custom endpoint (Ollama, LM Studio)

# Trading Defaults
DEFAULT_MAX_RISK_PER_TRADE=1.0
DEFAULT_MAX_ALLOCATION_PER_TRADE=10.0
DEFAULT_DAILY_LOSS_LIMIT=5.0

# Max Pairs Per User
MAX_PAIRS_PER_USER=100

# Scanner Settings
SCANNER_CYCLE_INTERVAL=3m

# AI Trading Parameters
MIN_CONFIDENCE_THRESHOLD=85
MAX_RISK_LEVEL=low

# Pre-AI Filters (Syarat sebelum koin dianalisa AI)
MIN_VOLATILITY_PERCENT=0.5
MIN_VOLUME_24H=100000

# ============================================================
# TRADING MODE PRESET
# ============================================================
# Available modes: conservative, moderate, aggressive
# Each mode has predefined values for risk, allocation, and filters.
# Individual params can still be overridden via explicit env vars.
TRADING_MODE=moderate

# Aggressive Preset Values (for reference):
#   DEFAULT_MAX_RISK_PER_TRADE=2.0      (vs0.5 conservative, 1.0 moderate)
#   DEFAULT_MAX_ALLOCATION_PER_TRADE=20.0  (vs 5.0 conservative, 10.0 moderate)
#   DEFAULT_DAILY_LOSS_LIMIT=8.0       (vs 3.0 conservative, 5.0 moderate)
#   DEFAULT_MAX_OPEN_POSITIONS=5        (vs 2 conservative, 3 moderate)
#   MIN_CONFIDENCE_THRESHOLD=70         (vs 90 conservative, 85 moderate)
#   MAX_RISK_LEVEL=high                 (vs low conservative, medium moderate)
#   MIN_VOLATILITY_PERCENT=0.2          (vs 1.0 conservative, 0.5 moderate)
#   MIN_VOLUME_24H=50000                (vs 500000 conservative, 100000 moderate)
